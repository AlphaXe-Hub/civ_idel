FROM node:22-bookworm AS build
WORKDIR /app
COPY . .
RUN npm ci && npm run build -w @civ-idle/game-core && npm run build -w @civ-idle/web

FROM nginx:1.27-alpine
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY config/game-speed.json /usr/share/nginx/html/game-speed.json
EXPOSE 80
